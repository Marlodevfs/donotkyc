---
// Ancienne adresse : GitHub Pages ne sait pas rediriger en 301, on pose un canonical et un rafraîchissement immédiat.
interface Props { to: string }
const { to } = Astro.props;
const abs = 'https://www.donotkyc.com' + to;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={abs} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body><p><a href={to}>{abs}</a></p></body>
</html>
