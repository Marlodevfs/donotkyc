---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { TOOL_PAGES, sorted } from '../data/tools';
import { dict, useT, lp, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const L = (p: string) => lp(lang, p);
const d = dict(lang).tools;
const site = 'https://www.donotkyc.com';
const groups = ['network', 'crypto'] as const;
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: t('nav.directory'), item: site + L('/') }, { '@type': 'ListItem', position: 2, name: d.name, item: site + L('/tools') }] }];
---
<Base title={`${d.hub_h1} | DoNotKYC`} description={d.hub_intro[0]} path="/tools" lang={lang} localized nav="tools" jsonld={jsonld}>
  <div class="wrap det">
    <nav class="crumb" aria-label="Breadcrumb"><a href={L('/')}>{t('nav.directory')}</a><Icon name="chevron-right" size={15} /><span aria-current="page">{d.name}</span></nav>
    <header class="lh">
      <h1>{d.hub_h1}</h1>
      {d.hub_intro.map((p: string) => <p>{p}</p>)}
      <p class="small">{d.sort}</p>
    </header>
    {groups.map((g) => (
      <section class="sec" aria-labelledby={`g-${g}`}>
        <h2 id={`g-${g}`}>{d.groups[g]}</h2>
        <ul class="hub">
          {TOOL_PAGES.filter((p) => p.group === g).map((p) => (
            <li><a href={L(`/tools/${p.key}`)}><b>{d.pages[p.key].h1}</b><span>{d.pages[p.key].intro[0]}</span><small>{sorted(p.key).length}</small></a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
