---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mono from '../components/Mono.astro';
import Level from '../components/Level.astro';
import Rows from '../components/Rows.astro';
import SponsorTile from '../components/SponsorTile.astro';
import { LANDINGS, itemsFor, landingText } from '../data/landings';
import { platforms, CATEGORIES, TYPES, byLeastId } from '../lib/platforms';
import { dict, useT, lp, tx, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const sp = lang === 'zh' ? '' : ' '; // pas d'espace entre les segments en chinois
const L = (p: string) => lp(lang, p);
const site = 'https://www.donotkyc.com';
const alts = LANDINGS.filter((l) => l.group === 'alternative');
const buys = LANDINGS.filter((l) => l.group === 'coin' || l.group === 'payment');
const list = [...platforms].sort(byLeastId);
const noId = platforms.filter((p) => p.kyc_level === 'none').length;
const count = (c: (typeof CATEGORIES)[number]) => (c.key === 'all' ? platforms.length : platforms.filter((p) => c.types.includes(p.type)).length);

// Mots-clés de recherche en plus des champs affichés (les termes anglais restent cherchables dans toutes les langues)
const KW: Record<string, string> = {
  Bisq: 'bitcoin cash bank sepa tor', Trocador: 'monero xmr tor', WizardSwap: 'monero xmr tor', StealthEX: 'monero xmr card',
  Boltz: 'lightning bitcoin liquid', 'Hodl Hodl': 'bitcoin cash bank', 'Peach Bitcoin': 'bitcoin cash bank lightning',
  LocalCoinSwap: 'cash bank gift cards', SilentSwap: 'privacy',
};
const hay = (p: (typeof platforms)[number]) =>
  [p.name, TYPES[p.type], t(`types.${p.type}`), p.kyc_summary, p.kyc_tier, p.supported_countries, p.cryptocurrencies, ...(p.features ?? []), p.fiat_deposit ? 'card bank fiat cash' : '', KW[p.name] ?? '']
    .join(' ').toLowerCase();
const picks = ['bisq', 'trocador', 'peach-bitcoin'].map((slug) => ({ p: platforms.find((x) => x.slug === slug)!, text: t(`home.pick_${slug}`) }));
const faq = t('home.faq') as [string, string][];
const catLabels = Object.fromEntries(CATEGORIES.map((c) => [c.key, t(`cats.${c.key}`)]));

const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': site + '/#org', name: 'DoNotKYC', url: site + '/', logo: site + '/og-image.png',
    sameAs: ['https://x.com/donotkyc', 'https://t.me/donotkycdotcom', 'https://github.com/Marlodevfs/donotkyc'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': site + '/#website', url: site + L('/'), name: 'DoNotKYC', publisher: { '@id': site + '/#org' }, inLanguage: lang },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: t('home.title'), numberOfItems: list.length,
    itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: site + L(`/p/${p.slug}`) })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: lang,
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
const i18n = { labels: catLabels, filteredBy: t('home.filtered_by'), clear: t('home.clear'), none: t('home.chip_none'), fiat: t('home.chip_fiat'), us: t('home.chip_us') };
---
<Base title={t('home.title')} description={t('home.description', { n: platforms.length })} path="/" lang={lang} localized nav="directory" jsonld={jsonld}>
  <div class="wrap">
    <section class="hero">
      <h1>{t('home.h1_a')}{sp}<em>{t('home.h1_em')}</em>{sp}{t('home.h1_b')}</h1>
      <p>{t('home.lead', { n: platforms.length })}</p>
      <form class="search" id="sform" role="search" action="#directory">
        <label class="sbox"><Icon name="search" /><span class="vis">{t('home.search_label')}</span>
          <input id="q" name="q" type="search" autocomplete="off" placeholder={t('home.search_ph')} />
          <button type="submit">{t('home.search_btn')}</button>
        </label>
        <div class="sugg"><span>{t('home.popular')}</span>
          <button type="button" data-s="monero">{t('home.s_monero')}</button>
          <button type="button" data-s="cash">{t('home.s_cash')}</button>
          <button type="button" data-s="lightning">{t('home.s_lightning')}</button>
          <button type="button" data-s="card">{t('home.s_card')}</button>
        </div>
      </form>
      <aside class="proof" aria-label={t('home.facts')}>
        <div><b class="num">{platforms.length}</b><span>{t('home.f_listed')}</span></div>
        <div><b class="num">{noId}</b><span>{t('home.f_noid')}</span></div>
        <div><b class="num">6</b><span>{t('home.f_types')}</span></div>
      </aside>
      <div class="bmc">
        <a href="https://buymeacoffee.com/donotkyc" target="_blank" rel="noopener noreferrer" aria-label={t('footer.coffee')}><img src="/bmc-button.png" width="220" height="62" alt="Buy me a coffee" /></a>
        <small>{t('home.coffee_note')}</small>
      </div>
    </section>

    <section aria-label={t('home.categories')}>
      <div class="cats" id="cats">
        {CATEGORIES.map((c) => (
          <button class="cat" type="button" data-c={c.key} aria-pressed={c.key === 'all' ? 'true' : 'false'}>
            <span class="ic-box"><Icon name={c.icon} /></span><b>{catLabels[c.key]}</b><small>{t('cats.listed', { n: count(c) })}</small>
          </button>
        ))}
      </div>
    </section>

    <section class="dir" id="directory" aria-labelledby="dir-h">
      <div class="dir-head">
        <h2 id="dir-h">{t('home.all_platforms')} <span class="num" id="count">{list.length}</span></h2>
        <div class="filters">
          <button class="chip" type="button" data-f="none" aria-pressed="false"><Icon name="user-x" size={16} />{t('home.chip_none')}</button>
          <button class="chip" type="button" data-f="fiat" aria-pressed="false"><Icon name="credit-card" size={16} />{t('home.chip_fiat')}</button>
          <button class="chip" type="button" data-f="us" aria-pressed="false"><Icon name="map-pin" size={16} />{t('home.chip_us')}</button>
          <label class="vis" for="sort">{t('home.sort')}</label>
          <select id="sort"><option value="lvl">{t('home.sort_lvl')}</option><option value="name">{t('home.sort_name')}</option></select>
        </div>
      </div>
      <div class="active" id="active" aria-live="polite"></div>
      <Rows items={list} id="list" hay={hay} lang={lang} />
      <div class="empty" id="empty" hidden>{t('home.empty')} <button type="button" data-reset>{t('home.clear_filters')}</button></div>
    </section>

    <section class="sec" aria-labelledby="pay-h">
      <div class="sec-h"><h2 id="pay-h">{t('home.pay_h')}</h2><p>{t('home.pay_p')}</p></div>
      <ul class="idx n5">
        {buys.map((l) => (<li><a href={L(l.path)}><span class="from">{t(l.group === 'coin' ? 'home.coin_from' : 'home.pay_from')}</span><span class="name">{landingText(lang, l.path).nav}</span><span class="alt">{t('cats.listed', { n: itemsFor(l).length })}<Icon name="arrow-right" size={16} /></span></a></li>))}
      </ul>
    </section>

    <section class="sec" aria-labelledby="alt-h">
      <div class="sec-h"><h2 id="alt-h">{t('home.alt_h')}</h2><p>{t('home.alt_p')}</p></div>
      <ul class="idx">
        {alts.map((l) => (<li><a href={L(l.path)}><span class="from">{t('home.instead_of')}</span><span class="name">{landingText(lang, l.path).nav}</span><span class="alt">{t('home.n_alternatives', { n: itemsFor(l).length })}<Icon name="arrow-right" size={16} /></span></a></li>))}
      </ul>
    </section>

    <section class="sec" aria-labelledby="ft-h">
      <div class="sec-h"><h2 id="ft-h">{t('home.picks_h')}</h2><p>{t('home.picks_p')}</p></div>
      <div class="feat">
        {picks.map(({ p, text }) => (
          <a class="card" href={L(`/p/${p.slug}`)}>
            <div class="top"><Mono p={p} /><Level level={p.kyc_level} lang={lang} /></div>
            <h3>{p.name}</h3><p>{text}</p>
            <div class="foot"><span>{t(`types.${p.type}`)}</span><span>{tx(lang, p.kyc_summary)}</span></div>
          </a>
        ))}
        <SponsorTile slot="home" fallback lang={lang} />
      </div>
    </section>

    <section class="sec trust" id="how" aria-labelledby="tr-h">
      <div>
        <h2 id="tr-h">{t('home.how_h')}</h2>
        <p class="lead">{t('home.how_p')}</p>
      </div>
      <div>
        <ul class="types">
          {[['landmark', 'cex'], ['network', 'dex'], ['repeat', 'swap'], ['users', 'p2p'], ['banknote', 'atm']].map(([ic, k]) => (
            <li><Icon name={ic} size={28} /><div><h3>{t(`home.t_${k}_h`)}</h3><p>{t(`home.t_${k}_p`)}</p></div></li>
          ))}
        </ul>
        <div class="rules">
          <div class="rule"><b><Icon name="badge-check" />{t('home.r1_h')}</b><p>{t('home.r1_p')}</p></div>
          <div class="rule"><b><Icon name="link" />{t('home.r2_h')}</b><p>{t('home.r2_p')}</p></div>
        </div>
      </div>
    </section>

    <section class="sec guide" aria-labelledby="gd-h">
      <h2 id="gd-h">{t('home.guide_h')}</h2>
      <div class="body">
        <p>{t('home.guide_p1')}</p>
        <h3>{t('home.guide_h2')}</h3><p>{t('home.guide_p2')}</p>
        <h3>{t('home.guide_h3')}</h3><p>{t('home.guide_p3')}</p>
        <h3>{t('home.guide_h4')}</h3><p>{t('home.guide_p4')}</p>
      </div>
    </section>

    <section class="sec" id="tools" aria-labelledby="tl-h">
      <div class="sec-h"><h2 id="tl-h">{t('tools.hub_h1')}</h2><p>{t('tools.hub_intro')[0]}</p></div>
      <ul class="hub hub-3">
        {['vpn', 'wallets', 'hardware-wallets', 'tor', 'desktop-os', 'email'].map((k) => (
          <li><a href={L(`/tools/${k}`)}><b>{dict(lang).tools.pages[k].h1}</b><span>{dict(lang).tools.pages[k].intro[0]}</span></a></li>
        ))}
      </ul>
      <p><a class="hub-more" href={L('/tools')}>{t('tools.all')}</a></p>
    </section>

    <section class="sec" id="advertise" aria-labelledby="ad-h">
      <div class="band">
        <div><h2 id="ad-h">{t('home.ad_h')}</h2><p>{t('home.ad_p')}</p></div>
        <a href={L('/advertise')}>{t('home.ad_btn')}<Icon name="arrow-right" size={18} /></a>
      </div>
    </section>

    <section class="sec faq" aria-labelledby="fq-h">
      <h2 id="fq-h">{t('home.faq_h')}</h2>
      <div class="qs">
        {faq.map(([q, a]) => (<details><summary>{q}<Icon name="plus" /></summary><p>{a}</p></details>))}
      </div>
    </section>
  </div>

  <script is:inline type="application/json" id="i18n" set:html={JSON.stringify(i18n)} />
  <script is:inline>
    (function () {
      var I = JSON.parse(document.getElementById('i18n').textContent);
      var S = { cat: 'all', q: '', none: false, fiat: false, us: false, sort: 'lvl' };
      var list = document.getElementById('list'), items = Array.prototype.slice.call(list.children);
      var q = document.getElementById('q'), cats = document.getElementById('cats');
      function render() {
        var t = S.q.trim().toLowerCase(), n = 0;
        items.forEach(function (li) {
          var d = li.dataset;
          var ok = (S.cat === 'all' || d.cat === S.cat) && (!S.none || d.level === 'none') && (!S.fiat || d.fiat === '1') && (!S.us || d.us === '1') && (!t || d.hay.indexOf(t) !== -1);
          li.hidden = !ok; if (ok) n++;
        });
        items.slice().sort(function (a, b) { return S.sort === 'name' ? a.dataset.name.localeCompare(b.dataset.name) : a.dataset.rank - b.dataset.rank; })
          .forEach(function (li) { list.appendChild(li); });
        document.getElementById('count').textContent = n;
        document.getElementById('empty').hidden = n > 0;
        var act = [];
        if (S.cat !== 'all') act.push(I.labels[S.cat]); if (t) act.push('"' + S.q.trim() + '"');
        if (S.none) act.push(I.none); if (S.fiat) act.push(I.fiat); if (S.us) act.push(I.us);
        var a = document.getElementById('active'); a.textContent = '';
        if (act.length) { a.append(I.filteredBy.replace('{x}', act.join(', ')) + ' '); var b = document.createElement('button'); b.type = 'button'; b.dataset.reset = ''; b.textContent = I.clear; a.append(b); }
      }
      cats.addEventListener('click', function (e) {
        var b = e.target.closest('.cat'); if (!b) return; S.cat = b.dataset.c;
        cats.querySelectorAll('.cat').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
        render(); document.getElementById('directory').scrollIntoView({ behavior: 'smooth' });
      });
      document.querySelectorAll('.chip[data-f]').forEach(function (c) {
        c.addEventListener('click', function () { var f = c.dataset.f; S[f] = !S[f]; c.setAttribute('aria-pressed', S[f]); render(); });
      });
      document.getElementById('sort').addEventListener('change', function (e) { S.sort = e.target.value; render(); });
      q.addEventListener('input', function () { S.q = q.value; render(); });
      document.getElementById('sform').addEventListener('submit', function (e) { e.preventDefault(); document.getElementById('directory').scrollIntoView({ behavior: 'smooth' }); });
      document.querySelector('.sugg').addEventListener('click', function (e) {
        var b = e.target.closest('[data-s]'); if (!b) return; q.value = S.q = b.dataset.s; render();
        document.getElementById('directory').scrollIntoView({ behavior: 'smooth' });
      });
      document.addEventListener('click', function (e) {
        if (!e.target.closest('[data-reset]')) return;
        S = { cat: 'all', q: '', none: false, fiat: false, us: false, sort: S.sort }; q.value = '';
        document.querySelectorAll('.chip[data-f]').forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
        cats.querySelectorAll('.cat').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.c === 'all'); });
        render();
      });
      var p = new URLSearchParams(location.search).get('q'); if (p) { q.value = S.q = p; render(); }
    })();
  </script>
</Base>
