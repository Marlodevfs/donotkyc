---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Rows from '../components/Rows.astro';
import SponsorTile from '../components/SponsorTile.astro';
import { activeFor } from '../lib/sponsors';
import { LANDINGS, itemsFor, GROUP_LABEL, type Landing } from '../data/landings';

export function getStaticPaths() {
  return LANDINGS.map((l) => ({ params: { slug: l.path.slice(1) }, props: { l } }));
}
const { l } = Astro.props as { l: Landing };
const site = 'https://www.donotkyc.com';
const items = itemsFor(l);
const noId = items.filter((p) => p.kyc_level === 'none').length;
const related = LANDINGS.filter((x) => x.group === l.group && x.path !== l.path);
const others = LANDINGS.filter((x) => x.group === 'category' && l.group !== 'category');
const crumbs = [{ name: 'Directory', item: site + '/' }, { name: l.nav, item: site + l.path }];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })) },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: l.h1, numberOfItems: items.length,
    itemListElement: items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: `${site}/p/${p.slug}` })) },
  ...(l.faq ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: l.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }] : []),
];
---
<Base title={l.title} description={l.description} path={l.path} jsonld={jsonld}>
  <div class="wrap det">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Directory</a><Icon name="chevron-right" size={15} />{l.group !== 'category' && <><span>{GROUP_LABEL[l.group]}</span><Icon name="chevron-right" size={15} /></>}<span aria-current="page">{l.nav}</span></nav>
    <header class="lh">
      <h1>{l.h1}</h1>
      {l.intro.map((t) => <p>{t}</p>)}
      <p class="small">{items.length} platforms listed, {noId} with no ID at all. Sorted by how much identity they ask for.</p>
    </header>
    {activeFor(l.path) && <div class="sp-band"><SponsorTile slot={l.path} /></div>}
    <section class="dir" aria-label="Platforms">
      <Rows items={items} />
    </section>
    {l.faq && (
      <section class="sec faq" aria-labelledby="lq-h">
        <h2 id="lq-h">Questions</h2>
        <div class="qs">{l.faq.map(([q, a]) => (<details><summary>{q}<Icon name="plus" /></summary><p>{a}</p></details>))}</div>
      </section>
    )}
    <section class="sec rel" aria-labelledby="rl-h">
      <h2 id="rl-h">See also</h2>
      <ul>
        {related.map((x) => <li><a href={x.path}>{x.h1}</a></li>)}
        {others.map((x) => <li><a href={x.path}>{x.h1}</a></li>)}
        <li><a href="/">All platforms in the directory</a></li>
      </ul>
    </section>
  </div>
</Base>
