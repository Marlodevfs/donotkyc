---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { LANDINGS } from '../data/landings';
import { activeSponsors } from '../lib/sponsors';
const cats = LANDINGS.filter((l) => l.group !== 'alternative').map((l) => l.nav);
const current = activeSponsors();
---
<Base title="Advertise on DoNotKYC | Sponsored placements" description="Reach people who already avoid KYC. Clearly labelled sponsored tiles, reviewed advertisers, paid in crypto." path="/advertise">
  <div class="wrap page"><div class="prose">
    <h1>Advertise on DoNotKYC</h1>
    <p>DoNotKYC is read by people who want to trade crypto without handing over their identity. A sponsored tile puts your service next to the platforms they compare, with a Sponsored label.</p>
    <p><a class="btn" href="https://t.me/donotkycdotcom" rel="noopener">Contact us on Telegram<Icon name="arrow-up-right" /></a></p>

    <h2>Placements</h2>
    <ul>
      <li><strong>Homepage tile:</strong> one sponsor at a time, in the "Where we would start" section.</li>
      <li><strong>Topic page tile:</strong> one sponsor per page, above the list. Pages include {cats.join(', ')}.</li>
    </ul>
    <p>Placements run by calendar month. Prepaying 3 or 12 months reduces the monthly rate. Ask for current rates and audience figures.</p>

    <h2>The rules</h2>
    <ul>
      <li>Every tile says "Sponsored" and links with <code>rel="sponsored"</code>.</li>
      <li>Paying does not change a listing, its identity level or its position in the directory.</li>
      <li>We review every advertiser before accepting. We refuse services with credible scam or frozen-funds reports, and anything illegal where it is offered.</li>
      <li>We can remove a tile if new evidence of harm to users appears. Conditions are agreed before payment.</li>
    </ul>

    <h2>How it works</h2>
    <ol>
      <li>Send us your service, the placement you want and the dates on Telegram.</li>
      <li>We review the service and reply within a few days.</li>
      <li>You receive a crypto invoice (Bitcoin, Lightning or Monero).</li>
      <li>Once paid, the tile goes live on the start date and comes down on the end date automatically. We remind you before it ends.</li>
    </ol>

    <h2>Current sponsors</h2>
    {current.length ? <ul>{current.map((s) => <li>{s.name} ({s.slot === 'home' ? 'homepage' : s.slot}), until {s.end}</li>)}</ul> : <p>No sponsored placement is running right now.</p>}
  </div></div>
</Base>
