---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Mono from '../../components/Mono.astro';
import Level from '../../components/Level.astro';
import { platforms, TYPES, LEVELS, byLeastId, visitUrl, reportUrl, CATEGORY_PATH, CUSTODY, PAYMENTS, KYC_ASKED, lastTest, fmtDate, type Platform, type Test } from '../../lib/platforms';

export function getStaticPaths() {
  return platforms.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Platform };
const site = 'https://www.donotkyc.com';
const type = TYPES[p.type];
const level = LEVELS[p.kyc_level].label;
const similar = platforms.filter((x) => x.type === p.type && x.slug !== p.slug).sort(byLeastId).slice(0, 5);
const host = new URL(p.url).hostname.replace(/^www\./, '');
const report = reportUrl(p.name);
const last = lastTest(p);
const tests = ((p.tests ?? []) as Test[]).slice().sort((a, b) => b.date.localeCompare(a.date));
const title = `${p.name}: KYC policy, limits and fees | DoNotKYC`;
const description = `${p.name} is a ${type.toLowerCase()}. Identity asked: ${level} (${p.kyc_summary.toLowerCase()}). ${p.fiat_deposit ? 'Accepts card or bank deposits.' : 'Crypto only.'} Fees: ${p.fees}. Availability: ${p.supported_countries}.`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Directory', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: type, item: site + CATEGORY_PATH[p.type] },
    { '@type': 'ListItem', position: 3, name: p.name, item: `${site}/p/${p.slug}` },
  ],
};
---
<Base title={title} description={description} path={`/p/${p.slug}`} jsonld={jsonld}>
  <div class="wrap det">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Directory</a><Icon name="chevron-right" size={15} /><a href={CATEGORY_PATH[p.type]}>{type}</a><Icon name="chevron-right" size={15} /><span aria-current="page">{p.name}</span></nav>
    <div class="dh">
      <Mono p={p} size={72} />
      <div>
        <h1>{p.name}</h1>
        <p>{type}. {p.kyc_summary}.</p>
        <div class="chips"><Level level={p.kyc_level} />{last && <span class="lvl l-none"><Icon name="badge-check" size={15} />Tested {fmtDate(last.date)}</span>}<span class="lvl l-plain">{p.fiat_deposit ? 'Card or bank accepted' : 'Crypto only'}</span></div>
      </div>
      <div class="acts">
        <a class="btn" href={visitUrl(p)} rel={p.affiliate_link ? 'sponsored noopener' : 'noopener'}>Visit {host}<Icon name="arrow-up-right" /></a>
        <span class="small">{p.affiliate_link ? 'Affiliate link. It never changes the order.' : 'No affiliate link.'}</span>
      </div>
    </div>

    {p.status === 'check' && <div class="warn status"><Icon name="triangle-alert" /><span><strong>Being re-checked.</strong> {p.status_note}</span></div>}
    <div class="dg">
      <div>
        <section class="panel" aria-labelledby="kyc-h">
          <h2 id="kyc-h">Identity and limits</h2>
          <p><strong>{p.kyc_summary}.</strong>{p.kyc_tier.toLowerCase() !== LEVELS[p.kyc_level].label.toLowerCase() && <> Listed policy: {p.kyc_tier}.</>}</p>
          <div class="warn"><Icon name="triangle-alert" /><span>Policies change without notice. Start with a small amount, and check the platform's own terms before moving larger sums. Platforms without ID checks give you privacy and less recourse if something goes wrong.</span></div>
        </section>
        {p.features.length > 0 && (
          <section class="panel" aria-labelledby="ft-h">
            <h2 id="ft-h">Features</h2>
            <ul class="tags">{p.features.map((f) => <li>{f}</li>)}</ul>
          </section>
        )}
        <section class="panel" aria-labelledby="ts-h">
          <h2 id="ts-h">Our tests</h2>
          {tests.length ? (
            <ul class="hist">{tests.map((t) => (
              <li><time datetime={t.date}>{fmtDate(t.date)}</time><span>{t.steps} with {t.amount} by {t.method}. {t.result}</span><b>{KYC_ASKED[t.kyc_asked]}</b></li>
            ))}</ul>
          ) : (
            <p>We have not run a paid test on {p.name} yet. This listing is based on its published terms{p.kyc_source && <> (<a href={p.kyc_source} rel="noopener">source</a>)</>}. <a href="/methodology">How we test</a>.</p>
          )}
        </section>
        <section class="panel" aria-labelledby="rp-h">
          <h2 id="rp-h">Something changed?</h2>
          <p>If {p.name} now asks for ID, changed its limits or closed, <a href={report} rel="noopener">tell us on GitHub</a>. Every report is checked before the listing is updated.</p>
        </section>
      </div>
      <div>
        <section class="panel" aria-labelledby="ag-h">
          <h2 id="ag-h">At a glance</h2>
          <dl>
            <div><dt>Identity asked</dt><dd>{level}</dd></div>
            <div><dt>Type</dt><dd>{type}</dd></div>
            <div><dt>Custody</dt><dd>{CUSTODY[p.custody]}</dd></div>
            <div><dt>Payment</dt><dd>{p.payment_methods.map((m) => PAYMENTS[m]).join(', ')}</dd></div>
            {p.tor !== null && <div><dt>Tor access</dt><dd>{p.tor ? 'Yes' : 'No'}</dd></div>}
            {p.open_source !== null && <div><dt>Open source</dt><dd>{p.open_source ? 'Yes' : 'No'}</dd></div>}
            <div><dt>Fees</dt><dd class="num">{p.fees}</dd></div>
            <div><dt>Availability</dt><dd>{p.supported_countries}</dd></div>
            {p.cryptocurrencies && <div><dt>Coins</dt><dd>{p.cryptocurrencies}</dd></div>}
            {p.volume_24h && <div><dt>24h volume</dt><dd class="num">{p.volume_24h}</dd></div>}
            {p.reputation && <div><dt>Reputation</dt><dd>{p.reputation}</dd></div>}
          </dl>
        </section>
        {similar.length > 0 && (
          <section class="panel" aria-labelledby="sm-h">
            <h2 id="sm-h">Similar platforms</h2>
            <ul class="sim">
              {similar.map((s) => (
                <li><span class="pf"><Mono p={s} /><span><b><a href={`/p/${s.slug}`}>{s.name}</a></b><small>{s.kyc_summary}</small></span></span><Level level={s.kyc_level} /></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </div>
</Base>
