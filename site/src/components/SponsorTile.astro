---
import Icon from './Icon.astro';
import { activeFor } from '../lib/sponsors';
import { useT, lp, type Lang } from '../i18n';
interface Props { slot: string; fallback?: boolean; lang?: Lang }
const { slot, fallback = false, lang = 'en' } = Astro.props;
const t = useT(lang);
const s = activeFor(slot);
const host = s ? new URL(s.url).hostname.replace(/^www\./, '') : '';
---
{s ? (
  <aside class="card ad" aria-label={`${t('sponsor.label')}: ${s.name}`}>
    <div class="top"><span class="adl">{t('sponsor.label')}</span>{s.logo && <img class="sp-logo" src={'/' + s.logo} alt="" width="40" height="40" loading="lazy" />}</div>
    <h3>{s.name}</h3>
    <p>{s.tagline}</p>
    <a href={s.url} rel="sponsored noopener">{t('sponsor.visit', { host })}<Icon name="arrow-up-right" size={16} /></a>
    <div class="foot"><span>{t('sponsor.paid')}</span><a href={lp(lang, '/advertise')}>{t('sponsor.why')}</a></div>
  </aside>
) : fallback && (
  <div class="card ad">
    <div class="top"><span class="adl">{t('sponsor.slot')}</span></div>
    <h3>{t('sponsor.here_h')}</h3>
    <p>{t('sponsor.here_p')}</p>
    <a href={lp(lang, '/advertise')}>{t('sponsor.how')}<Icon name="arrow-right" size={16} /></a>
  </div>
)}
