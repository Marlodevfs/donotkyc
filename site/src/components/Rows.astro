---
// Lignes de l'annuaire (accueil, catégories, alternatives…). data-* sert aux filtres de l'accueil.
import Icon from './Icon.astro';
import Mono from './Mono.astro';
import Level from './Level.astro';
import { TYPES, catOf, type Platform } from '../lib/platforms';
interface Props { items: Platform[]; id?: string; hay?: (p: Platform) => string }
const { items, id, hay } = Astro.props;
---
<div class="hd" aria-hidden="true"><span>Platform</span><span>Identity asked</span><span>Card or bank</span><span>Fees</span><span>Not available in</span><span></span></div>
<ul class="list" id={id}>
  {items.map((p, i) => (
    <li class="it" data-cat={catOf(p)} data-level={p.kyc_level} data-fiat={p.fiat_deposit ? '1' : '0'}
        data-us={p.blocked && /\bUS\b/.test(p.blocked) ? '0' : '1'} data-name={p.name.toLowerCase()} data-rank={i} data-hay={hay?.(p)}>
      <div class="pfc"><div class="pf"><Mono p={p} /><div><b><a href={`/p/${p.slug}`}>{p.name}</a></b><small>{TYPES[p.type]}</small></div></div></div>
      <div class="lvc"><Level level={p.kyc_level} /><span class="sub">{p.kyc_summary}</span></div>
      <div class="c c-fiat">{p.fiat_deposit ? <b>Yes</b> : 'No'}</div>
      <div class="c c-fee num">{p.fees}</div>
      <div class="c c-blk">{p.blocked ?? 'Available everywhere'}</div>
      <div class="metac"><span>{p.fiat_deposit ? 'Card or bank' : 'Crypto only'}</span><span>Fees {p.fees}</span></div>
      <div class="goc"><a class="go" href={`/p/${p.slug}`} aria-label={`${p.name} details`}>Details<Icon name="arrow-right" size={16} /></a></div>
    </li>
  ))}
</ul>
