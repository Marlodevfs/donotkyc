---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import fontLatin from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import { reportUrl } from '../lib/platforms';
import { LOCALES, HREFLANG, useT, lp, langName, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  path: string;            // chemin sans préfixe de langue, ex. "/swaps"
  lang?: Lang;
  localized?: boolean;     // la page existe dans toutes les langues (hreflang + sélecteur)
  type?: 'website' | 'article';
  jsonld?: object | object[];
  nav?: 'directory' | 'blog' | 'tools' | 'privacy' | 'security' | null;
}
const { title, description, path, lang = 'en', localized = false, type = 'website', jsonld, nav = null } = Astro.props;
const t = useT(lang);
const site = 'https://www.donotkyc.com';
const url = site + lp(lang, path);
const lds = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const L = (p: string) => lp(lang, p);
const links = [
  { key: 'directory', href: L('/'), label: t('nav.directory') },
  { key: 'blog', href: '/blog', label: t('nav.blog') },
  { key: 'tools', href: L('/tools'), label: t('nav.tools') },
  { key: 'privacy', href: L('/privacy'), label: t('nav.privacy') },
  { key: 'security', href: L('/security'), label: t('nav.security') },
];
---
<!doctype html>
<html lang={HREFLANG[lang]} dir={t('meta.dir')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {localized && LOCALES.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={site + lp(l, path)} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={site + path} />}
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="DoNotKYC changelog" href="/rss.xml" />
    <meta name="theme-color" content="#0F172A" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="DoNotKYC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={HREFLANG[lang].replace('-', '_')} />
    <meta property="og:image" content={site + '/og-image.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@donotkyc" />
    {lds.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <header class="bar">
      <div class="wrap">
        <a class="logo" href={L('/')} aria-label={t('nav.home')}><img class="lg-l" src="/logo-light.svg" alt="" width="116" height="40" /><img class="lg-d" src="/logo-dark.svg" alt="" width="116" height="40" /></a>
        <nav class="nav" id="nav" aria-label="Main">
          {links.map((l) => <a href={l.href} aria-current={nav === l.key ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <div class="tools">
          <details class="lang">
            <summary aria-label={`${t('nav.language')}: ${lang.toUpperCase()}`}><Icon name="languages" />{lang.toUpperCase()}</summary>
            <ul>
              {LOCALES.map((l) => (
                <li><a href={localized ? lp(l, path) : lp(l, '/')} hreflang={HREFLANG[l]} lang={HREFLANG[l]} aria-current={l === lang ? 'true' : undefined}>{langName(l)}</a></li>
              ))}
            </ul>
          </details>
          <a class="ibtn" href={L('/search')} aria-label={t('nav.search')}><Icon name="search" /></a>
          <button class="ibtn" id="theme" type="button" aria-label={t('nav.theme')}><Icon name="sun-moon" /></button>
          <button class="ibtn menu" id="menu" type="button" aria-label={t('nav.menu')} aria-controls="nav" aria-expanded="false"><Icon name="menu" /></button>
          <a class="cta-s" href={L('/advertise')}>{t('nav.advertise')}</a>
        </div>
      </div>
    </header>

    <main id="main" data-pagefind-body><slot /></main>

    <footer class="site">
      <div class="wrap">
        <div class="fg">
          <div>
            <a class="logo" href={L('/')} aria-label={t('nav.home')}><img class="lg-l" src="/logo-light.svg" alt="" width="116" height="40" /><img class="lg-d" src="/logo-dark.svg" alt="" width="116" height="40" /></a>
            <p>{t('footer.about')}</p>
          </div>
          <div><h2>{t('footer.directory')}</h2><ul>
            <li><a href={L('/') + '#directory'}>{t('footer.all')}</a></li>
            <li><a href={L('/submit')}>{t('footer.submit')}</a></li>
            <li><a href={L('/compare')}>{t('compare.index_h1')}</a></li>
            <li><a href={L('/methodology')}>{t('footer.how')}</a></li>
            <li><a href={L('/advertise')}>{t('footer.advertise')}</a></li>
            <li><a href={reportUrl()} rel="noopener">{t('footer.report')}</a></li>
            <li><a href="/api-docs">{t('footer.api')}</a></li>
            <li><a href="/changelog">Changelog</a></li>
            <li><a href={L('/how-we-make-money')}>{t('footer.money')}</a></li>
            <li><a href={L('/privacy-policy')}>{t('footer.privacy_policy')}</a></li>
          </ul></div>
          <div><h2>{t('footer.browse')}</h2><ul>
            <li><a href={L('/exchanges')}>{t('footer.exchanges')}</a></li>
            <li><a href={L('/swaps')}>{t('footer.swaps')}</a></li>
            <li><a href={L('/p2p')}>{t('footer.p2p')}</a></li>
            <li><a href={L('/buy/bitcoin')}>{t('footer.bitcoin')}</a></li>
            <li><a href={L('/buy/monero')}>{t('footer.monero')}</a></li>
          </ul></div>
          <div><h2>{t('footer.guides')}</h2><ul>
            <li><a href={L('/privacy')}>{t('footer.privacy')}</a></li>
            <li><a href={L('/security')}>{t('footer.security')}</a></li>
            <li><a href={L('/tools')}>{t('nav.tools')}</a></li>
            <li><a href={L('/tools/vpn')}>{t('footer.vpn')}</a></li>
            <li><a href="/blog">{t('footer.blog')}</a></li>
          </ul>{lang !== 'en' && <p class="small">{t('footer.english_only')}</p>}</div>
          <div><h2>{t('footer.community')}</h2><ul>
            <li><a href="https://x.com/donotkyc" rel="noopener">X</a></li>
            <li><a href="https://t.me/donotkycdotcom" rel="noopener">Telegram</a></li>
            <li><a href="https://www.tiktok.com/@donotkyc" rel="noopener">TikTok</a></li>
            <li><a href="https://github.com/Marlodevfs/donotkyc" rel="noopener">GitHub</a></li>
          </ul></div>
        </div>
        <div class="legal">
          <p>{t('footer.legal')}</p>
          <span>© 2026 DoNotKYC · {t('footer.made_by').split('{name}')[0]}<a href="https://github.com/Marlodevfs" rel="noopener">Marlodevfs</a>{t('footer.made_by').split('{name}')[1]}</span>
        </div>
      </div>
    </footer>

    <script data-goatcounter="https://donotkyc.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <noscript><img src={`https://donotkyc.goatcounter.com/count?p=${encodeURIComponent(lp(lang, path))}`} alt="" width="1" height="1" /></noscript>

    <script is:inline>
      (function () {
        var root = document.documentElement, b = document.getElementById('theme');
        function mode() { return root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); }
        b.addEventListener('click', function () {
          var next = mode() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
        var m = document.getElementById('menu'), n = document.getElementById('nav');
        m.addEventListener('click', function () { var open = n.classList.toggle('open'); m.setAttribute('aria-expanded', open); });
        document.addEventListener('click', function (e) { var d = document.querySelector('details.lang'); if (d && d.open && !d.contains(e.target)) d.open = false; });
      })();
    </script>
  </body>
</html>
